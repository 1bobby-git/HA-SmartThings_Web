#!/command/with-contenv sh
set -eu

export HOME=/data
export XDG_CACHE_HOME=/data/chromium-profile/.cache
export XDG_CONFIG_HOME=/data/chromium-profile/.config
export XDG_DATA_HOME=/data/chromium-profile/.local/share
export XDG_STATE_HOME=/data/chromium-profile/.local/state

if [ ! -r /app/dist/bridge/src/main.js ]; then
  printf '%s\n' "bridge_service:missing_compiled_main" >&2
  exit 111
fi

printf '%s\n' "bridge_service:start" >&2
exec s6-setuidgid pwuser node --experimental-sqlite /app/dist/bridge/src/main.js
