#!/command/with-contenv sh
set -u
umask 077

log() {
  printf '%s\n' "$1" >&2
}

write_marker() {
  marker="$1"
  rm -f -- "$marker" || return 1
  : > "$marker" || return 1
  chown pwuser:pwuser "$marker" || return 1
  chmod 0600 "$marker" || return 1
}

DATA_DIR=/data
MIGRATED_MARKER="$DATA_DIR/.ownership-migrated-v2"
MAINTENANCE_REQUIRED="$DATA_DIR/.profile-maintenance-required"
MAINTENANCE_FAILED="$DATA_DIR/.profile-maintenance-failed"

if [ "${1:-}" = "migrate" ]; then
  migration_failed=0
  for directory in /data/chromium-profile /data/downloads /data/camera-images; do
    [ -d "$directory" ] || continue
    find "$directory" -xdev \
      \( -type d -o -type f \) \
      \( ! -user pwuser -o ! -group pwuser \) \
      -exec chown pwuser:pwuser {} + || migration_failed=1
  done
  exit "$migration_failed"
fi

log "profile_maintenance:start"

if [ ! -f "$MAINTENANCE_REQUIRED" ] || [ -L "$MAINTENANCE_REQUIRED" ]; then
  log "profile_maintenance:not_requested"
  exit 0
fi

maintenance_failed=0

for cache_path in \
  "/data/chromium-profile/Default/Cache" \
  "/data/chromium-profile/Default/Code Cache" \
  "/data/chromium-profile/Default/GPUCache" \
  "/data/chromium-profile/Default/Service Worker/CacheStorage" \
  "/data/chromium-profile/Default/Service Worker/ScriptCache" \
  "/data/chromium-profile/GrShaderCache" \
  "/data/chromium-profile/ShaderCache" \
  "/data/chromium-profile/GraphiteDawnCache" \
  "/data/chromium-profile/DawnGraphiteCache" \
  "/data/chromium-profile/DawnWebGPUCache" \
  "/data/chromium-profile/Crashpad"; do
  if ! rm -rf -- "$cache_path" 2>/dev/null; then
    maintenance_failed=1
    log "profile_maintenance:cache_cleanup_failed"
  fi
done

find /data/downloads -mindepth 1 -type f -mtime +7 -delete 2>/dev/null || \
  log "profile_maintenance:download_cleanup_failed"

if [ ! -f "$MIGRATED_MARKER" ]; then
  log "profile_maintenance:ownership_migration_start"
  if timeout --signal=TERM --kill-after=5s 180s "$0" migrate; then
    if write_marker "$MIGRATED_MARKER"; then
      log "profile_maintenance:ownership_migration_complete"
    else
      maintenance_failed=1
      log "profile_maintenance:ownership_marker_write_failed"
    fi
  else
    maintenance_failed=1
    log "profile_maintenance:ownership_migration_timeout_or_failed"
  fi
fi

if [ "$maintenance_failed" -eq 0 ]; then
  rm -f -- "$MAINTENANCE_FAILED" || maintenance_failed=1
fi

if [ "$maintenance_failed" -ne 0 ]; then
  if ! write_marker "$MAINTENANCE_FAILED"; then
    log "profile_maintenance:failure_marker_write_failed"
  fi
  log "profile_maintenance:failed"
else
  log "profile_maintenance:complete"
fi

if ! rm -f -- "$MAINTENANCE_REQUIRED"; then
  log "profile_maintenance:request_cleanup_failed"
fi

exit 0
