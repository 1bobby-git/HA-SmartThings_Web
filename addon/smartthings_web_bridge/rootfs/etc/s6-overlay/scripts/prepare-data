#!/command/with-contenv sh
set -eu

test -d /data
chown pwuser:pwuser /data
OWNERSHIP_MARKER="/data/.ownership-migrated-v2"

for directory in /data/chromium-profile /data/downloads /data/camera-images; do
  mkdir -p "$directory"
  chown pwuser:pwuser "$directory"
  chmod 0700 "$directory"
done

# Home Assistant Supervisor can replace options.json as root after an update,
# and SQLite can recreate sidecar files. Repair only the small top-level files
# on every start; never walk the Chromium profile during normal startup.
for file in \
  /data/options.json \
  /data/bridge-secret \
  /data/bridge.sqlite \
  /data/bridge.sqlite-wal \
  /data/bridge.sqlite-shm \
  /data/bridge.sqlite-journal \
  /data/settings.json \
  /data/protocol-fingerprint.json; do
  if [ -f "$file" ] && [ ! -L "$file" ]; then
    chown pwuser:pwuser "$file"
  fi
done

if [ ! -f "$OWNERSHIP_MARKER" ]; then
  migration_failed=0
  for directory in /data/chromium-profile /data/downloads /data/camera-images; do
    find "$directory" -xdev \( -type d -o -type f \) -exec chown pwuser:pwuser {} + || migration_failed=1
  done
  if [ "$migration_failed" -eq 0 ]; then
    touch "$OWNERSHIP_MARKER"
    chown pwuser:pwuser "$OWNERSHIP_MARKER"
    chmod 0600 "$OWNERSHIP_MARKER"
  else
    echo "data_prep_recursive_ownership_retry_required" >&2
  fi
fi

for cache_path in \
  "/data/chromium-profile/Default/Cache" \
  "/data/chromium-profile/Default/Code Cache" \
  "/data/chromium-profile/Default/GPUCache" \
  "/data/chromium-profile/Default/Service Worker/CacheStorage" \
  "/data/chromium-profile/Default/Service Worker/ScriptCache" \
  "/data/chromium-profile/GrShaderCache" \
  "/data/chromium-profile/ShaderCache" \
  "/data/chromium-profile/GraphiteDawnCache" \
  "/data/chromium-profile/DawnGraphiteCache" \
  "/data/chromium-profile/DawnWebGPUCache" \
  "/data/chromium-profile/Crashpad"; do
  rm -rf -- "$cache_path" 2>/dev/null || true
done

find /data/downloads -mindepth 1 -type f -mtime +7 -delete 2>/dev/null || true
