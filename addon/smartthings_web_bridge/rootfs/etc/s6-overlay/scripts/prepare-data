#!/command/with-contenv sh
set -eu
umask 077

log() {
  printf '%s\n' "$1" >&2
}

fail() {
  log "data_prep:failed:$1"
  exit 1
}

DATA_DIR=/data
MIGRATED_MARKER="$DATA_DIR/.ownership-migrated-v2"
MAINTENANCE_REQUIRED="$DATA_DIR/.profile-maintenance-required"
MAINTENANCE_FAILED="$DATA_DIR/.profile-maintenance-failed"

log "data_prep:start"

[ -d "$DATA_DIR" ] || fail "missing_data_dir"
chown pwuser:pwuser "$DATA_DIR" || fail "data_dir_chown"

for directory in /data/chromium-profile /data/downloads /data/camera-images; do
  [ ! -L "$directory" ] || fail "invalid_runtime_directory:${directory##*/}"
  mkdir -p "$directory" || fail "runtime_directory_create:${directory##*/}"
  [ -d "$directory" ] || fail "invalid_runtime_directory:${directory##*/}"
  chown pwuser:pwuser "$directory" || fail "runtime_directory_chown:${directory##*/}"
  chmod 0700 "$directory" || fail "runtime_directory_mode:${directory##*/}"
done

for file in \
  /data/options.json \
  /data/bridge-secret \
  /data/bridge.sqlite \
  /data/bridge.sqlite-wal \
  /data/bridge.sqlite-shm \
  /data/bridge.sqlite-journal \
  /data/settings.json \
  /data/protocol-fingerprint.json; do
  if [ -e "$file" ] || [ -L "$file" ]; then
    [ -f "$file" ] && [ ! -L "$file" ] || fail "invalid_critical_file:${file##*/}"
    chown pwuser:pwuser "$file" || fail "critical_file_chown:${file##*/}"
    chmod 0600 "$file" || fail "critical_file_mode:${file##*/}"
  fi
done

if [ -e "$MIGRATED_MARKER" ] || [ -L "$MIGRATED_MARKER" ]; then
  [ -f "$MIGRATED_MARKER" ] && [ ! -L "$MIGRATED_MARKER" ] || fail "invalid_ownership_marker"
  chown pwuser:pwuser "$MIGRATED_MARKER" || fail "ownership_marker_chown"
  chmod 0600 "$MIGRATED_MARKER" || fail "ownership_marker_mode"
fi

rm -f -- "$MAINTENANCE_FAILED" || fail "maintenance_failure_cleanup"
rm -f -- "$MAINTENANCE_REQUIRED" || fail "maintenance_request_cleanup"
: > "$MAINTENANCE_REQUIRED" || fail "maintenance_request_create"
chown pwuser:pwuser "$MAINTENANCE_REQUIRED" || fail "maintenance_request_chown"
chmod 0600 "$MAINTENANCE_REQUIRED" || fail "maintenance_request_mode"

log "data_prep:profile_maintenance_scheduled"
log "data_prep:ready"
